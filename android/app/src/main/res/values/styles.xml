<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts. The app opens dark by default,
         so the launch background is its navy in light and dark system modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window behind the Flutter UI once it runs (Flutter embedding V2). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
