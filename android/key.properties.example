# Copy to android/key.properties and fill in with your upload keystore.
# This file (key.properties) is gitignored — never commit the real one.
# On Windows, use forward slashes in storeFile because backslashes in Java
# properties files can be interpreted as escape sequences.
# Example: storeFile=C:/Users/Edu/path/upload-keystore.jks
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/upload-keystore.jks
